{
  "model": "projects.project",
  "pk": 3,
  "fields": {
    "title": "Girls Empowerment Program",
    "slug": "girls-empowerment-program",
    "category": 3,
    "summary": "Mentorship, skills training, and business support for young women and girls to build confidence, earn income, and lead in their communities.",
    "description": "The Girls Empowerment Program runs in 12 community centres across Kenya, offering mentorship, vocational training, financial literacy, and startup support. Over 200 young women have graduated from the program. Many have started their own businesses and are now mentoring the next generation of girls coming through.",
