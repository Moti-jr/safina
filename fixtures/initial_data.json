{
  "model": "projects.project",
  "pk": 1,
  "fields": {
    "title": "School Bursary Program",
    "slug": "school-bursary-program",
    "category": 1,
    "summary": "Supporting bright students from low-income families with full school bursaries so no child misses out on education due to poverty.",
    "description": "The School Bursary Program has supported over 120 students across Nairobi and Rift Valley counties since 2015. We partner with local schools to identify the most vulnerable students and provide full bursaries covering tuition, uniforms, books, and meals. Our goal is simple — no child should miss school because their family cannot afford it.",
    "image": "projects/2.jpeg",
    "status": "ongoing",
    "beneficiaries": 120,
    "location": "Nairobi & Rift Valley",
    "start_date": "2026-07-01",
    "end_date": "2026-08-21",
    "is_featured": true,
    "is_published": true,
    "meta_description": "",
    "created_at": "2026-07-31T08:06:21.254Z",
    "updated_at": "2026-07-31T08:06:21.254Z"
  }
},
{
  "model": "projects.project",
  "pk": 2,
  "fields": {
    "title": "Mobile Health Clinics",
    "slug": "mobile-health-clinics",
    "category": 2,
    "summary": "Bringing essential healthcare services directly to remote communities that have little or no access to formal medical facilities.",
    "description": "Our Mobile Health Clinics travel to underserved villages across Kenya every month, providing free consultations, maternal health services, immunisations, and health education. Since launching in 2018, we have conducted over 80 outreaches reaching more than 3,000 patients who would otherwise go without care.",
    "image": "projects/3.jpeg",
    "status": "ongoing",
    "beneficiaries": 3000,
    "location": "Western & Rift Valley Kenya",
    "start_date": "2026-07-31",
