{
  "model": "news.newsarticle",
  "pk": 1,
  "fields": {
    "title": "50 Students Receive Full Bursaries for the 2025 School Year",
    "slug": "50-students-receive-full-bursaries-for-the-2025-sc",
    "summary": "Safina Initiative has awarded full bursaries to 50 deserving students across Nairobi county, covering tuition, uniforms, and meals for the entire school year.",
    "body": "This year marks our biggest bursary intake yet. After receiving over 300 applications from schools across Nairobi, our team visited 45 schools and interviewed 120 candidates before selecting 50 students who demonstrated both academic potential and genuine financial need. Each student will receive full coverage of their school fees, uniforms, books, and daily meals. We are proud to invest in the next generation of Kenyan leaders.",
    "image": "news/4.jpeg",
    "is_featured": true,
    "is_published": true,
    "meta_description": "",
    "published_at": "2025-07-13",
    "created_at": "2026-07-31T08:15:27.180Z",
    "updated_at": "2026-07-31T08:15:27.180Z",
    "tags": []
  }
},
{
  "model": "news.newsarticle",
  "pk": 2,
  "fields": {
    "title": "Mobile Clinic Reaches 500 Patients in Western Kenya",
    "slug": "mobile-clinic-reaches-500-patients-in-western-keny",
    "summary": "Our latest mobile health outreach to Bungoma and Kakamega counties reached over 500 patients in just three days, providing free consultations and essential medicines.",
    "body": "Last month our team of doctors, nurses, and community health workers spent three days in Bungoma and Kakamega counties. We set up clinics in three market centres and schools, seeing over 500 patients across all age groups. Services included general consultations, maternal health checks, child immunisations, malaria testing and treatment, and nutritional assessments. Community members walked up to 10 kilometres to access care — a clear reminder of how much this work matters.",
    "image": "news/5.jpeg",
    "is_featured": true,
    "is_published": true,
    "meta_description": "",
    "published_at": "2025-04-02",
    "created_at": "2026-07-31T08:17:09.865Z",
    "updated_at": "2026-07-31T08:17:09.865Z",
    "tags": []
  }
},
